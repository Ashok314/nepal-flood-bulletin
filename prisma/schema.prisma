generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Human-curated links to official posts / notices (tweets, gov bulletins).
// Nothing here auto-publishes: an admin adds and (optionally) marks it verified.
model CuratedPost {
  id        String   @id @default(cuid())
  type      String   @default("link") // "tweet" | "link" | "notice"
  url       String
  title     String
  source    String   @default("") // e.g. "@handle", "NDRRMA", "Nepal Police"
  verified  Boolean  @default(false)
  pinned    Boolean  @default(false)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-row configuration + cached snapshot of the upstream JSON feed.
model FeedConfig {
  id              Int      @id @default(1)
  feedUrl         String
  backupFeedUrl   String   @default("")
  refreshInterval Int      @default(300) // seconds
  lastFetchedAt   DateTime?
  lastStatus      String   @default("never") // "ok" | "error" | "never"
  lastError       String   @default("")
  lastGoodPayload String   @default("") // raw JSON of last successful fetch
  updatedAt       DateTime @updatedAt
}

// Moderation overlay applied on top of the upstream feed at serve time.
// The upstream data is never mutated — we only hide/flag by entry id.
model ModerationFlag {
  id        String   @id @default(cuid())
  entryId   String   @unique // matches an entry `id` from the feed
  action    String   @default("hide") // "hide" | "flag"
  reason    String   @default("")
  createdAt DateTime @default(now())
}
