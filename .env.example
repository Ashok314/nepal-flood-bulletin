# Copy to .env for local (non-Docker) development: `cp .env.example .env`
# Docker uses the values in docker-compose.yml instead of this file.

# Local SQLite database file
DATABASE_URL="file:./dev.db"

# Single admin account for the /admin panel
ADMIN_USER="admin"
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie (use a long random string)
SESSION_SECRET="change-this-to-a-long-random-string-please"

# Set to "true" only when serving over HTTPS
COOKIE_SECURE="false"
